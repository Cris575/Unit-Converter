@* @model TModel *@

<form asp-controller="Home" asp-action="UnitConvert">
    <div class="form-group">
        <input type="number" class="form-control" id="exampleInputEmail1" aria-describedby="emailHelp" placeholder="Enter Measure" name="Measure">
    </div>
    <div class="form-group">
        @* <label for="exampleInputPassword1">Password</label> *@
        @* <input type="password" class="form-control" id="exampleInputPassword1" placeholder="Password"> *@
        <select class="form-select" aria-label="Default select example" name="unitFrom">
            <option selected disabled>Open this select menu</option><option value="mm">Millimeter</option>
            <option value="cm">Centimeter</option>
            <option value="m">Meter</option>
            <option value="km">Kilometer</option>
            <option value="in">Inch</option>
            <option value="ft">Foot</option>
            <option value="yd">Yard</option>
            <option value="mi">Mile</option>
        </select>

    </div>
    <div class="form-group">
        @* <label for="exampleInputPassword1">Password</label> *@
        @* <input type="password" class="form-control" id="exampleInputPassword1" placeholder="Password"> *@
        <select class="form-select" aria-label="Default select example" name="unitTo">
            <option selected disabled>Open this select menu</option>
            <option value="mm">Millimeter</option>
            <option value="cm">Centimeter</option>
            <option value="m">Meter</option>
            <option value="km">Kilometer</option>
            <option value="in">Inch</option>
            <option value="ft">Foot</option>
            <option value="yd">Yard</option>
            <option value="mi">Mile</option>
        </select>
    </div>
    <div class="form-group d-none">
        <input type="text" aria-hidden="True" value="Length" name="View"/>
    </div>
    <button type="submit" class="btn btn-primary">Submit</button>
</form>
