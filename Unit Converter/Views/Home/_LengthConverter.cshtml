@* @model TModel *@

<form asp-controller="Home" asp-action="UnitConvert">
    <div class="form-group">
        <label for="exampleInputEmail1">Email address</label>
        <input type="number" class="form-control" id="exampleInputEmail1" aria-describedby="emailHelp" placeholder="Enter email" name="Measure">
    </div>
    <div class="form-group">
        @* <label for="exampleInputPassword1">Password</label> *@
        @* <input type="password" class="form-control" id="exampleInputPassword1" placeholder="Password"> *@
        <select class="form-select" aria-label="Default select example" name="unitFrom">
            <option selected disabled>Open this select menu</option>
            <option>Millimeter</option>
            <option>Centimeter</option>
            <option>Meter</option>
            <option>Kilometer</option>
            <option>Inch</option>
            <option>Foot</option>
            <option>Yard</option>
            <option>Mile</option>
        </select>

    </div>
    <div class="form-group">
        @* <label for="exampleInputPassword1">Password</label> *@
        @* <input type="password" class="form-control" id="exampleInputPassword1" placeholder="Password"> *@
        <select class="form-select" aria-label="Default select example" name="unitTo">
            <option selected disabled>Open this select menu</option>
            <option>Millimeter</option>
            <option>Centimeter</option>
            <option>Meter</option>
            <option>Kilometer</option>
            <option>Inch</option>
            <option>Foot</option>
            <option>Yard</option>
            <option>Mile</option>
        </select>
    </div>
    <div class="form-group d-none">
        <input type="text" aria-hidden="True" value="Length" name="View"/>
    </div>
    <button type="submit" class="btn btn-primary">Submit</button>
</form>
