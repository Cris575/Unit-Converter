
<form asp-controller="Home" asp-action="UnitConvert">
    <div class="form-group">
        <label for="inputWeight">Weight / Mass</label>
        <input type="number" step="any" class="form-control" id="inputWeight" placeholder="Enter value" name="Measure">
    </div>
    <div class="form-group">
        <select class="form-select" aria-label="Select unit from" name="unitFrom">
            <option selected disabled>Open this select menu</option>
            <option value="Celsius">Celsius</option>
            <option value="Fahrenheit">Fahrenheit</option>
            <option value="Kelvin">Kelvin</option>
        </select>
    </div>
    <div class="form-group">
        <select class="form-select" aria-label="Select unit to" name="unitTo">
            <option selected disabled>Open this select menu</option>
            <option value="Celsius">Celsius</option>
            <option value="Fahrenheit">Fahrenheit</option>
            <option value="Kelvin">Kelvin</option>
        </select>
    </div>
    <div class="form-group d-none">
        <input type="text" aria-hidden="True" value="Temperatures" name="View"/>
    </div>
    <button type="submit" class="btn btn-primary">Submit</button>
</form>