<form asp-controller="Home" asp-action="UnitConvert">
    <div class="form-group">
        <input type="number" step="any" class="form-control" id="inputWeight" placeholder="Enter Measure" name="Measure">
    </div>
    <div class="form-group">
        <select class="form-select" aria-label="Select unit from" name="unitFrom">
            <option selected disabled>Open this select menu</option> 
            <option value="mg">Milligram</option>
            <option value="g">Gram</option>
            <option value="kg">Kilogram</option>
            <option value="oz">Ounce</option>
            <option value="lb">Pound</option>
        </select>
    </div>
    <div class="form-group">
        <select class="form-select" aria-label="Select unit to" name="unitTo">
            <option selected disabled>Open this select menu</option>
            <option value="mg">Milligram</option>
            <option value="g">Gram</option>
            <option value="kg">Kilogram</option>
            <option value="oz">Ounce</option>
            <option value="lb">Pound</option>
        </select>
    </div>
    <div class="form-group d-none">
        <input type="text" aria-hidden="True" value="Weight" name="View"/>
    </div>
    <button type="submit" class="btn btn-primary">Submit</button>
</form>